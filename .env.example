# Copy to .env and fill in:  cp .env.example .env

# ---- Public domain (DNS A record must point at this server) ----
KC_DOMAIN=auth.example.com

# ---- First-boot admin account (change the password after first login) ----
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-to-something-long

# ---- Aiven for PostgreSQL (Aiven Console -> your service -> Overview -> Connection information) ----
AIVEN_PG_HOST=pg-xxxxxxx-yourproject.a.aivencloud.com
AIVEN_PG_PORT=12345
AIVEN_PG_DATABASE=keycloak
AIVEN_PG_USER=avnadmin
AIVEN_PG_PASSWORD=your-aiven-password

# require     = encrypted, no certificate check (works out of the box)
# verify-full = encrypted + verifies Aiven's CA; download the CA cert to ./certs/ca.pem
#               and set AIVEN_PG_SSLROOTCERT=1
AIVEN_PG_SSLMODE=require
AIVEN_PG_SSLROOTCERT=

# Keep below your Aiven plan's max_connections (Hobbyist/Startup plans are small)
KC_DB_POOL_MAX_SIZE=10
KC_LOG_LEVEL=info
