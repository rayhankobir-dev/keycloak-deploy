# Copy to .env and fill in:  cp .env.example .env
# These are Keycloak's own variable names, so you can paste them into any hosting platform's env settings.

# ---- First-boot admin (change the password after first login) ----
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-something-long

# ---- Database (any PostgreSQL: Aiven, Neon, etc.; SSL is required) ----
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://your-db-host:5432/your-db-name?sslmode=require
KC_DB_USERNAME=your-db-user
KC_DB_PASSWORD=your-db-password
# Keep below your database plan's connection limit
KC_DB_POOL_MAX_SIZE=10

# ---- HTTP (TLS is terminated by the platform/proxy in front of Keycloak) ----
KC_HOSTNAME=auth.example.com
KC_HTTP_ENABLED=true
KC_HTTP_HOST=0.0.0.0
KC_HTTP_PORT=8000
KC_PROXY_HEADERS=xforwarded
